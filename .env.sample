# Development only. The values belong to a test tenant and a test app registration,
# never production credentials.
#
# Copy this file to .env (git ignores .env), fill it in and keep it private (chmod 600 .env).
# Load it into your shell with: set -a; . ./.env; set +a
# Quote a value in single quotes when it holds spaces or shell characters such as $.
#
# No Java code reads this file. The live test and the serial-mail sample read the environment
# variables; the sample does so through morimail-sample-serial/dev-account.properties.
#
# Where the values come from: docs/entra-setup.md walks through every step. The hints below
# name the step. Keep the key, the certificate and the .p12 outside the repository.

# Tenant ID of the test tenant.
# Entra admin center > Entra ID > App registrations > your app > Overview > "Directory (tenant) ID".
MORIMAIL_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the test app.
# Same Overview page > "Application (client) ID". No app yet: New registration, single tenant,
# no redirect URI (entra-setup.md step 1).
MORIMAIL_DEV_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The mailbox the test app may send from.
# A licensed Exchange Online mailbox the app has Mail.Send for (entra-setup.md steps 3 and 7).
# A user without an Exchange mailbox gets 404 ErrorInvalidUser.
MORIMAIL_DEV_FROM=sender@example.com

# The recipient of the live test mails. Any mailbox you can read.
MORIMAIL_DEV_TO=recipient@example.org

# The PKCS12 file of the test app (entra-setup.md step 2), for example:
#   openssl req -x509 -newkey rsa:2048 -sha256 -nodes -keyout app.key -out app.cer -days 730 -subj "/CN=morimail-app"
#   openssl pkcs12 -export -inkey app.key -in app.cer -name morimail -out app.p12 -passout env:MORIMAIL_DEV_CERT_PASSWORD
# Then upload app.cer: your app > Certificates & secrets > Certificates > Upload certificate.
# Set MORIMAIL_DEV_CERT_PASSWORD in the shell first (read -rs MORIMAIL_DEV_CERT_PASSWORD && export MORIMAIL_DEV_CERT_PASSWORD).
MORIMAIL_DEV_CERT_PATH=/path/to/test-app.p12

# The password of that PKCS12 file, the one used with -passout above.
MORIMAIL_DEV_CERT_PASSWORD=

# A client secret in place of the certificate (quick first test; entra-setup.md step 2, end).
# Your app > Certificates & secrets > Client secrets > New client secret; copy the Value at once,
# Entra shows it only once. The live test uses the certificate when path and password are both
# set; dev-account.properties uses the certificate unless its commented secretEnv line is swapped in.
MORIMAIL_DEV_SECRET=

# Optional: a mailbox the test app must not send from, for the live test's out-of-scope probe.
# Only meaningful with Exchange RBAC for Applications (entra-setup.md step 3, path B): any
# mailbox outside the management scope. With tenant-wide Entra consent every mailbox is in scope.
MORIMAIL_DEV_OUT_OF_SCOPE_FROM=

# Optional: a file just under 3 MiB, for the live test's big-attachment probe. For example:
#   head -c 3000000 /dev/urandom > /path/to/big.bin
MORIMAIL_DEV_BIG_ATTACHMENT=
